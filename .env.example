# ===== Database =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nyayavault?schema=public"

# ===== Auth =====
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ===== Server =====
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# ===== File storage (local dev) =====
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# ===== AI provider =====
AI_PROVIDER="mock"
# If you later switch to a real OpenAI-compatible provider:
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
