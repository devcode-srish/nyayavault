# ===== Database =====
DATABASE_URL="postgresql://postgres:psfpass@localhost:5432/nyayavault?schema=public"

# ===== Auth =====
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ===== Server =====
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# ===== File storage (local dev) =====
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# ===== Encryption & Authority Keys =====
ENCRYPTION_SECRET="change-me-min-32-character-secret-key-for-aes-gcm"
# Single-line escaped PEM strings (\n for newlines):
SERVER_AUTHORITY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SERVER_AUTHORITY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ===== AI provider =====
AI_PROVIDER="mock"
# If you later switch to a real OpenAI-compatible provider:
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# Gemini Integration:
GEMINI_API_KEY=""
